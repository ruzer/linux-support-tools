#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 || "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  echo "Uso: mdread ARCHIVO.md"
  echo "Ejemplo: mdread README.md"
  exit 0
fi

file="$1"

if [[ ! -f "$file" ]]; then
  echo "No existe el archivo: $file"
  exit 1
fi

if command -v glow >/dev/null 2>&1; then
  exec glow -p "$file"
fi

if command -v batcat >/dev/null 2>&1; then
  exec batcat --language markdown --paging always "$file"
fi

if command -v bat >/dev/null 2>&1; then
  exec bat --language markdown --paging always "$file"
fi

exec less -R "$file"

